<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 🛡️ Sentinel: Protect sensitive local data like biometric status -->
        <exclude domain="sharedpref" path="user_prefs.xml"/>
        <!-- 🛡️ Sentinel: Do not backup internal database -->
        <exclude domain="database" path="moneyvisor.db"/>
    </cloud-backup>
    <device-transfer>
        <!-- 🛡️ Sentinel: Protect sensitive local data like biometric status -->
        <exclude domain="sharedpref" path="user_prefs.xml"/>
        <!-- 🛡️ Sentinel: Do not backup internal database -->
        <exclude domain="database" path="moneyvisor.db"/>
    </device-transfer>
</data-extraction-rules>
